<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.groupbuy.mapper.GroupBuyOrderMapper">
    
    <select id="findExpiredOrders" resultType="com.example.groupbuy.entity.GroupBuyOrder">
        SELECT * FROM group_buy_order
        WHERE status = 0
        AND end_time &lt;= #{now}
        AND is_queued = 0
        ORDER BY end_time ASC
    </select>
    
</mapper>
