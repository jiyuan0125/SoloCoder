# ========================================
# 环境变量配置文件演示
# ========================================

# 空行会被忽略

# ========================================
# 1. 基本配置 - 无引号值
# ========================================
DATABASE_HOST=localhost
DATABASE_NAME=my_app_database

# 值前后的空白会被自动去掉
  API_KEY  =  abc123def456  

# ========================================
# 2. 单引号 - 完全原样，不处理转义
# ========================================
# 单引号中的 \n 会被当做字面字符，不是换行
LITERAL_MESSAGE='hello\nworld\tfoo'

# ========================================
# 3. 双引号 - 支持转义序列
# ========================================
# 双引号支持: \n 换行, \t 制表符, \\ 反斜杠, \" 双引号
MESSAGE="Hello\nWorld!\tTab here\\Backslash\"Quote\""

# ========================================
# 4. 三引号 - 多行文本
# ========================================
MULTI_LINE_TEXT="""第一行内容
第二行内容
  第三行有缩进
第四行结束"""

# ========================================
# 5. 变量展开 - $VAR 和 ${VAR} 格式
# ========================================
# 引用已定义的变量
DATABASE_URL=postgresql://$DATABASE_HOST:5432/$DATABASE_NAME

# 使用 ${VAR} 格式可以避免歧义
FIRST_NAME=John
LAST_NAME=Doe
FULL_NAME=${FIRST_NAME}_${LAST_NAME}

# 嵌套引用 - SERVICE_URL -> FULL_NAME -> FIRST_NAME/LAST_NAME
SERVICE_URL=http://${FULL_NAME}.example.com/api

# 引用未定义的变量（默认展开为空字符串）
# 注意: $UNDEFINED_VAR_suffix 会被解析为变量 UNDEFINED_VAR_suffix（包含下划线）
# 要明确变量名边界，请使用 ${VAR} 格式
UNDEFINED_REF=prefix_$UNDEFINED_VAR_suffix

# 使用 ${VAR} 格式明确变量名边界
# ${FIRST_NAME}_suffix 会被解析为变量 FIRST_NAME + 字符串 _suffix
EXPLICIT_BOUNDARY=${DATABASE_NAME}_suffix

# ========================================
# 6. 整数值
# ========================================
PORT=3000
MAX_CONNECTIONS=100

# 无效的整数值（读取时会返回默认值）
INVALID_INT=not_a_number

# ========================================
# 7. 浮点数值
# ========================================
TIMEOUT=30.5
RATE_LIMIT=1000.99

# 无效的浮点数值
INVALID_FLOAT=abc123

# ========================================
# 8. 布尔值 - 支持多种格式，不区分大小写
# ========================================
DEBUG_MODE=true
ENABLE_LOGGING=1
FEATURE_FLAG=yes
DISABLED=false

# 无效的布尔值
INVALID_BOOL=maybe

# ========================================
# 9. 包含等号的值 - 正确解析为完整值
# ========================================
# 第一个 = 后面的所有内容都作为值
COMPLEX_PASSWORD=a=b=c=d=e=f
QUERY_STRING=key1=value1&key2=value2&key3=value3

# ========================================
# 10. 系统环境变量优先级测试
# ========================================
# 如果系统中已设置 SYSTEM_TEST_VAR，系统值会覆盖此值
SYSTEM_TEST_VAR=file_value
