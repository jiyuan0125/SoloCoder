{
  "listen_addr": ":8080",
  "timeout": 30,
  "routes": [
    {
      "path_prefix": "/api",
      "backends": [
        {"addr": "localhost:8081", "weight": 3},
        {"addr": "localhost:8082", "weight": 1}
      ]
    },
    {
      "path_prefix": "/static",
      "backends": [
        {"addr": "localhost:8083", "weight": 1}
      ]
    }
  ]
}
